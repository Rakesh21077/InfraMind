# =========================================================================
# InfraMind — Configuration Template (.env.example)
# Version 2: Real-Time Cloud Security Event Ingestion & AI Guardrail
# =========================================================================

# -------------------------------------------------------------------------
# 1. Operating Mode Configuration
# -------------------------------------------------------------------------
# Options:
#   'demo': Uses local SQLite store seeded with mock security logs. Zero AWS credentials required.
#   'live': Connects to real AWS SQS queue to ingest CloudTrail / GuardDuty events.
APP_MODE=demo

# -------------------------------------------------------------------------
# 2. AI Inference Engine & Model Provider
# -------------------------------------------------------------------------
# Options:
#   'ollama': Local Ollama inference instance.
#   'amd' or 'vllm': Remote AMD Instinct GPU running ROCm vLLM container.
#   'deterministic_fallback': Offline rule-based scoring with zero network calls.
AI_PROVIDER=ollama

# AMD Instinct GPU (ROCm vLLM) Endpoint URL (OpenAI Standard API compatible)
AMD_ENDPOINT_URL=http://localhost:11434/v1

# Local Ollama Endpoint URL
OLLAMA_ENDPOINT_URL=http://localhost:11434/v1

# Target LLM Model Name
MODEL_NAME=llama3:8b

# Optional API Key for authenticated endpoints
OPENAI_API_KEY=dummy-key

# -------------------------------------------------------------------------
# 3. AWS EventBridge & SQS Real-Time Pipeline (Required for APP_MODE=live)
# -------------------------------------------------------------------------
# Primary SQS Queue URL provisioned via infra/cloudformation-realtime.yaml
SQS_QUEUE_URL=

# AWS Named Profile for local development (leave blank for default credentials chain)
AWS_PROFILE=

# Target AWS Region
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# -------------------------------------------------------------------------
# 4. Persistent Storage (SQLite)
# -------------------------------------------------------------------------
# Path to local SQLite database file
DATABASE_PATH=data/inframind.db

# Dashboard refresh cadence in seconds
DASHBOARD_REFRESH_SECONDS=5

# -------------------------------------------------------------------------
# 5. Member 3: Auto-Patch & Cloud Remediation Safety Controls
# -------------------------------------------------------------------------
# Default Dry-Run Simulation: When True, simulates all S3 & IAM fixes without AWS calls.
DRY_RUN=True

# Master Live Execution Circuit Breaker: Must be True AND DRY_RUN=False AND operator approved.
LIVE_EXECUTION_ENABLED=False