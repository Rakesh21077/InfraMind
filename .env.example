# ==============================================================================
# InfraMind - Environment Configuration Template
# Copy this file to .env and configure for your local or AMD cloud environment.
# Never commit .env with real credentials to version control.
# ==============================================================================

# Inference Provider Selection: "ollama" (local), "amd_vllm" (AMD GPU cloud), or "mock" (offline test)
INFERENCE_PROVIDER="ollama"

# Local Ollama Configuration (Default for development)
OLLAMA_BASE_URL="http://localhost:11434"
MODEL_NAME="qwen2.5:7b"
LLM_TIMEOUT_SECONDS="30"

# AMD Developer Cloud / ROCm vLLM Endpoint (OpenAI-compatible)
# Canonical base URL must end in /v1. The client appends /chat/completions automatically.
AMD_ENDPOINT_URL="http://localhost:8000/v1"
AMD_API_KEY=""
AMD_REQUIRE_AUTH="false"
AMD_VLLM_USE_JSON_OBJECT="true"

# AWS Configuration
AWS_DEFAULT_REGION="us-east-1"

# Member 3: Auto-Patch & Remediation Safety Controls
# When DRY_RUN is True, all remediation actions run in simulation mode without calling AWS
DRY_RUN="True"

# Master circuit breaker for live AWS API remediation calls.
# Requires both DRY_RUN=False and LIVE_EXECUTION_ENABLED=True plus explicit human approval to execute.
LIVE_EXECUTION_ENABLED="False"